<div class="min-h-screen bg-lagom-bg text-lagom-text">
  <div class="flex min-h-screen">
    <aside class="sticky top-0 hidden h-screen w-64 shrink-0 overflow-y-auto border-r border-white/10 bg-lagom-surface/80 p-6 lg:block">
      <div class="mb-10">
        <div class="flex items-center gap-3">
          <%= helpers.image_tag "/icon.svg", alt: "", size: "36x36", class: "size-9 shrink-0 rounded-lg" %>
          <p class="text-lg font-semibold uppercase tracking-[0.18em]"><%= t("app.name") %></p>
        </div>
        <p class="mt-2 text-xs text-white/50"><%= t("app.tagline") %></p>
      </div>
      <nav class="space-y-2 text-sm">
        <%= helpers.link_to t("nav.merchants"), merchants_path, class: "block rounded-lg px-3 py-2 hover:bg-white/5" %>
        <%= helpers.link_to t("nav.disbursements"), disbursements_path, class: "block rounded-lg px-3 py-2 hover:bg-white/5" %>
        <%= helpers.link_to t("nav.monthly_fees"), monthly_fees_path, class: "block rounded-lg px-3 py-2 hover:bg-white/5" %>
        <%= helpers.link_to t("nav.yearly_report"), reports_yearly_path, class: "block rounded-lg px-3 py-2 hover:bg-white/5" %>
        <%= helpers.link_to t("nav.imports"), csv_imports_path, class: "block rounded-lg px-3 py-2 hover:bg-white/5" %>
      </nav>
      <div class="mt-10">
        <%= helpers.button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "text-sm text-white/60 hover:text-white" %>
      </div>
    </aside>

    <main class="flex min-w-0 flex-1 justify-center p-6 lg:p-10">
      <div class="w-full max-w-6xl">
        <% helpers.flash.each do |type, message| %>
          <%= render FlashComponent.new(type: type, message: message) %>
        <% end %>
        <%= content %>
      </div>
    </main>
  </div>
</div>
