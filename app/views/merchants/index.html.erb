<%= render AppShellComponent.new do %>
  <%= render PageHeaderComponent.new(title: t("merchants.index.title")) %>

  <% filtering = filtering?(:q, :live_on, :frequency) %>
  <% if filtering || @merchants.any? %>
    <%= render FilterBarComponent.new(url: merchants_path) do %>
      <%= render FilterFieldComponent.new(name: :q, label: t("filters.merchant"), value: params[:q]) %>
      <%= render FilterFieldComponent.new(name: :live_on, label: t("tables.live_since"), type: :date, value: params[:live_on]) %>
      <%= render FilterFieldComponent.new(
            name: :frequency,
            label: t("tables.disbursement_frequency"),
            type: :select,
            value: params[:frequency],
            options: Merchant.disbursement_frequencies.map { |key, label| [ label, key ] }
          ) %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "results", target: "_top" do %>
    <% if @merchants.empty? %>
      <%= render EmptyStateComponent.new(message: filtering ? t("filters.no_results") : t("merchants.index.empty")) %>
    <% else %>
      <%= render DataTableComponent.new(headers: [t("tables.merchant"), t("tables.email"), t("tables.live_since"), t("tables.disbursement_frequency"), t("tables.minimum_monthly_fee")], sorts: %w[reference email live_on frequency fee], sort: @sort) do %>
        <% @merchants.each do |merchant| %>
          <tr class="hover:bg-white/5">
            <td class="px-4 py-3"><%= link_to merchant.reference, merchant_path(merchant), class: "text-lagom-accent hover:underline" %></td>
            <td class="px-4 py-3 text-white/70"><%= merchant.email %></td>
            <td class="px-4 py-3 font-mono text-white/70"><%= l(merchant.live_on) %></td>
            <td class="px-4 py-3"><%= render BadgeComponent.new(text: merchant.disbursement_frequency_before_type_cast, variant: "accent") %></td>
            <td class="px-4 py-3"><%= render MoneyComponent.new(cents: merchant.minimum_monthly_fee_cents) %></td>
          </tr>
        <% end %>
      <% end %>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  <% end %>
<% end %>
