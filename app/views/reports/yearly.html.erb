<%= render AppShellComponent.new do %>
  <%= render PageHeaderComponent.new(title: t("reports.yearly.title")) %>
  <%= turbo_stream_from YearlyReportRefreshService::STREAM %>

  <% filtering = filtering?(:year) %>
  <% if filtering || @rows.any? || @adjustments.any? %>
    <%= render FilterBarComponent.new(url: reports_yearly_path) do %>
      <%= render FilterFieldComponent.new(name: :year, label: t("reports.yearly.year"), value: params[:year]) %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "results", target: "_top" do %>
    <% if @rows.empty? && @adjustments.empty? %>
      <%= render EmptyStateComponent.new(message: filtering ? t("filters.no_results") : t("reports.yearly.empty")) %>
    <% else %>
      <% if @rows.any? %>
        <div data-report="competence">
          <%= render DataTableComponent.new(
            headers: [
              t("reports.yearly.year"),
              t("reports.yearly.disbursements"),
              t("reports.yearly.amount_disbursed"),
              t("reports.yearly.order_fees"),
              t("reports.yearly.monthly_fees_count"),
              t("reports.yearly.monthly_fees_amount")
            ],
            sorts: %w[year disbursements amount_disbursed order_fees monthly_fees_count monthly_fees_amount],
            sort: @sort
          ) do %>
            <% @rows.each do |row| %>
              <tr class="hover:bg-white/5">
                <td class="px-4 py-3 font-mono"><%= row.year %></td>
                <td class="px-4 py-3 font-mono"><%= number_with_delimiter(row.disbursements_count) %></td>
                <td class="whitespace-nowrap px-4 py-3"><%= render MoneyComponent.new(cents: row.amount_disbursed_cents) %></td>
                <td class="whitespace-nowrap px-4 py-3"><%= render MoneyComponent.new(cents: row.order_fees_cents) %></td>
                <td class="px-4 py-3 font-mono"><%= number_with_delimiter(row.monthly_fees_count) %></td>
                <td class="whitespace-nowrap px-4 py-3"><%= render MoneyComponent.new(cents: row.monthly_fees_amount_cents) %></td>
              </tr>
            <% end %>
          <% end %>
        </div>
        <%= render "shared/pagination", pagy: @pagy %>
      <% end %>

      <% if @adjustments.any? %>
        <section class="mt-10" data-report="adjustments">
          <h2 class="text-xl font-semibold tracking-tight text-lagom-text"><%= t("reports.yearly.adjustments_title") %></h2>
          <p class="mt-2 mb-4 text-sm text-white/60"><%= t("reports.yearly.adjustments_hint") %></p>
          <%= render DataTableComponent.new(
            headers: [
              t("reports.yearly.charged_year"),
              t("reports.yearly.reference_year"),
              t("reports.yearly.adjustments_count"),
              t("reports.yearly.credit")
            ]
          ) do %>
            <% @adjustments.each do |row| %>
              <tr class="hover:bg-white/5">
                <td class="px-4 py-3 font-mono"><%= row.charged_year %></td>
                <td class="px-4 py-3 font-mono"><%= row.reference_year %></td>
                <td class="px-4 py-3 font-mono"><%= number_with_delimiter(row.adjustments_count) %></td>
                <td class="whitespace-nowrap px-4 py-3"><%= render MoneyComponent.new(cents: row.credit_cents) %></td>
              </tr>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% end %>
  <% end %>
<% end %>
