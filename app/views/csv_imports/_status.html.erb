<div class="mb-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <%= render StatComponent.new(label: t("labels.status"), value: csv_import.status) %>
  <% if csv_import.kind.present? %>
    <%= render StatComponent.new(label: t("labels.kind"), value: t("csv_imports.kinds.#{csv_import.kind}")) %>
  <% end %>
  <%= render StatComponent.new(label: t("csv_imports.show.imported"), value: csv_import.imported_count.to_s) %>
  <%= render StatComponent.new(label: t("csv_imports.show.failed"), value: csv_import.failed_count.to_s) %>
</div>

<% if csv_import.processing? || csv_import.pending? %>
  <%= render CardComponent.new do %>
    <p class="text-sm text-white/70"><%= t("csv_imports.show.processing") %></p>
  <% end %>
<% elsif csv_import.succeeded? %>
  <%= render CardComponent.new do %>
    <p class="text-sm text-emerald-200"><%= t("csv_imports.show.succeeded") %></p>
  <% end %>
<% elsif csv_import.failed? %>
  <%= render CardComponent.new do %>
    <p class="text-sm text-rose-200"><%= t("csv_imports.show.failed") %></p>
    <% if csv_import.error_message.present? %>
      <p class="mt-2 font-mono text-xs text-rose-100/80"><%= csv_import.error_message %></p>
    <% end %>
    <% if csv_import.error_rows.any? %>
      <div class="mt-4">
        <%= render ButtonComponent.new(
              text: t("csv_imports.show.download_errors"),
              href: errors_csv_import_path(csv_import),
              variant: "secondary"
            ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
