<%= render AppShellComponent.new do %>
  <%= render PageHeaderComponent.new(title: t("csv_imports.show.title")) %>

  <% if @csv_import.pending? || @csv_import.processing? %>
    <%= turbo_stream_from @csv_import %>
  <% end %>
  <%= render "csv_imports/status", csv_import: @csv_import %>
<% end %>
